{
  "start_urls": [
    "https://quotes.toscrape.com/"
  ],
  "item_selector": "div.quote",
  "fields": {
    "text": "span.text",
    "author": "small.author",
    "author_link": { "selector": "span a", "attr": "href" },
    "tags": "div.tags"
  },
  "next_page_selector": "li.next a",
  "max_pages": 3,
  "wait_for_selector": "div.quote",
  "infinite_scroll": false,
  "delay_min_seconds": 1,
  "delay_max_seconds": 2,
  "timeout_ms": 30000,
  "output": "quotes.json"
}
